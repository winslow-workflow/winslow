BaseModal .modal-content {
    width: 80%;
    height: 90%;
    border: round $secondary-lighten-1;
    background: $surface;

    .modal-header {
        height: 4;
        margin-bottom: 1;
        width: 100%;
        border-bottom: $secondary-lighten-1;

        .label-container {
            width: 10fr;
            padding-left: 10;
            padding-top: 1;

            Label { width: 1fr; }
        }

        .button-container {
            width: 2fr;
            padding-right: 1;
            align: right middle;
        }
    }

    .main {
        width: 100%;
        height: 100%;
        margin-left: 1;
        margin-right: 1;
        margin-bottom: 1;

    }

    TabbedContent {
        margin-top: 1;
    }
}
